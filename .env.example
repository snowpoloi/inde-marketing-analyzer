POSTGRES_DB=inde_marketing
POSTGRES_USER=inde
POSTGRES_PASSWORD=change-me-db-password

DATABASE_URL=postgresql+psycopg://inde:change-me-db-password@db:5432/inde_marketing
SECRET_KEY=change-me-long-random-secret
ENVIRONMENT=production
CORS_ORIGINS=https://analyzer.inde.gr,http://localhost:3000,http://localhost:5173

ADMIN_EMAIL=admin@inde.gr
ADMIN_PASSWORD=change-me-admin-password

SYNC_DAILY_HOUR=4
SYNC_TIMEZONE=Europe/Athens
# Same-day syncs of today at these hours (SYNC_TIMEZONE). Empty or "off" turns them off.
SYNC_INTRADAY_HOURS=8,10,12,14,16,18,20,22
SYNC_INTRADAY_PROVIDERS=google_ads,meta_ads,tiktok_ads,opencart,ga4

# Dedicated info@inde.gr Gmail read-only credentials; never commit populated values.
SUPPLIER_GMAIL_ENABLED=false
SUPPLIER_GMAIL_CLIENT_ID=
SUPPLIER_GMAIL_CLIENT_SECRET=
SUPPLIER_GMAIL_REFRESH_TOKEN=
